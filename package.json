{
  "name": "bitscope-bitstream-analyzer",
  "version": "0.1.0",
  "description": "A local visual analyzer for H.264, H.265, H.266, and AV1 bitstreams.",
  "author": "konnerzhu",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "desktop:prepare": "npm run native:h264:build && npm run native:av1:build",
    "desktop:dev": "npm run desktop:prepare && node desktop/dev.cjs",
    "desktop:renderer:build": "vite build --config vite.desktop.config.ts",
    "desktop:native:mac": "sh scripts/build-desktop-native-macos.sh",
    "desktop:native:win": "sh scripts/build-desktop-native-windows.sh",
    "desktop:icon:mac": "sh scripts/build-macos-icon.sh",
    "desktop:icon:win": "sh scripts/build-windows-icon.sh",
    "desktop:stage": "node scripts/stage-desktop-app.mjs",
    "desktop:dist:mac": "npm run desktop:renderer:build && npm run desktop:native:mac && npm run desktop:icon:mac && npm run desktop:stage && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64",
    "desktop:dist:win": "npm run desktop:renderer:build && npm run desktop:native:win && npm run desktop:icon:win && npm run desktop:stage && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64",
    "native:h264:configure": "cmake -S native/h264-inspector -B build/h264-inspector -DCMAKE_BUILD_TYPE=Release",
    "native:h264:build": "npm run native:h264:configure && cmake --build build/h264-inspector --parallel",
    "native:av1:configure": "cmake -S native/av1-decoder -B build/av1-decoder -DCMAKE_BUILD_TYPE=Release",
    "native:av1:build": "npm run native:av1:configure && cmake --build build/av1-decoder --parallel",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "^0.18.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.konnerzhu.bitscope",
    "productName": "BitScope",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "app": "dist-desktop/app",
      "output": "release"
    },
    "files": [
      "**/*",
      "!node_modules{,/**/*}"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.svg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "dist-desktop/native",
          "to": "native"
        },
        {
          "from": "dist-desktop/native-licenses",
          "to": "native-licenses"
        }
      ]
    },
    "win": {
      "icon": "build/icon.svg",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "dist-desktop/native-win",
          "to": "native"
        },
        {
          "from": "dist-desktop/native-licenses",
          "to": "native-licenses"
        }
      ]
    },
    "dmg": {
      "title": "BitScope ${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
